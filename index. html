<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مكتب الهجرة للطباعة والاستنساخ</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #0d1117;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }
        .container {
            width: 100%;
            max-width: 400px;
            text-align: center;
        }
        .icon {
            font-size: 50px;
            color: #25D366;
            margin-bottom: 10px;
        }
        h1 {
            font-size: 24px;
            margin-bottom: 10px;
        }
        p {
            color: #8b949e;
            font-size: 16px;
            margin-bottom: 30px;
        }
        .btn {
            display: block;
            width: 100%;
            background: linear-gradient(180deg, #25D366 0%, #1ebd59 100%);
            color: white;
            text-decoration: none;
            padding: 15px 10px;
            margin-bottom: 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3);
            transition: transform 0.2s;
            box-sizing: border-box;
        }
        .btn:active {
            transform: scale(0.98);
        }
        .btn-title {
            font-size: 18px;
            font-weight: bold;
            display: block;
            margin-bottom: 5px;
        }
        .btn-phone {
            font-size: 16px;
            direction: ltr;
            display: inline-block;
            letter-spacing: 1px;
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="icon">💬</div>
        
        <h1>مكتب الهجرة للطباعة</h1>
        <p>اختر الشخص الذي تريد التواصل معه</p>

        <!-- زر التواصل مع الأستاذ وليد -->
        <a href="https://wa.me/9647906644827" class="btn" target="_blank">
            <span class="btn-title">التواصل مع الأستاذ وليد</span>
            <span class="btn-phone">07906644827</span>
        </a>

        <!-- زر التواصل مع عمر -->
        <a href="https://wa.me/9647807174435" class="btn" target="_blank">
            <span class="btn-title">التواصل مع عمر</span>
            <span class="btn-phone">07807174435</span>
        </a>
    </div>

</body>
</html>
